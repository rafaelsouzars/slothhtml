<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Authors>Rafael Souza</Authors>
    <Description>Primeira versão do utilitário de git hooks.</Description>
    <PackageProjectUrl>https://github.com/rafaelsouzars/slothhtml.git</PackageProjectUrl>
    <Platforms>AnyCPU;x86;ARM64;ARM32;x64</Platforms>
    <RepositoryUrl>https://github.com/rafaelsouzars/slothhtml.git</RepositoryUrl>
    <Company>https://github.com/rafaelsouzars/</Company>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="prompito" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="docs\" />
  </ItemGroup>

</Project>
